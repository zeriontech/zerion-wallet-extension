{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2021",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["chrome", "node", "vitest/globals", "@types/dom-navigation"],
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"],
      "*": ["./*"],
      "@zeriontech/components/lib/Toggle": [
        "./node_modules/@zeriontech/components/lib/Toggle/index.d.ts"
      ],
      "@zeriontech/components/lib/UIText": [
        "./node_modules/@zeriontech/components/lib/UIText/index.d.ts"
      ],
      "capitalize-ts": ["./node_modules/capitalize-ts/lib/index.d.ts"],
      "normalized-contains": ["./node_modules/normalized-contains/lib/index.d.ts"],
      "react-area": ["./node_modules/react-area/dist/index.d.ts"]
    },
    "skipLibCheck": true
  },
  "exclude": ["./node_modules"],
  "include": ["src", "e2e", "playwright.config.ts"]
}
