{
  "name": "zerion-wallet",
  "version": "1.46.0",
  "description": "A web3 wallet extension",
  "keywords": [
    "Browser",
    "Wallet",
    "Web3"
  ],
  "homepage": "https://github.com/zeriontech/zerion-wallet-extension#readme",
  "bugs": {
    "url": "https://github.com/zeriontech/zerion-wallet-extension/issues"
  },
  "license": "GPL-3.0-only",
  "author": "everdimension <everdimension@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zeriontech/zerion-wallet-extension.git"
  },
  "scripts": {
    "prestart": "node scripts/verifyDotEnv.cjs",
    "start": "npm-run-all --parallel start:chrome typecheck:watch",
    "start:chrome": "node scripts/build.mjs --platform=chrome --watch",
    "start:firefox": "node scripts/build.mjs --platform=firefox --watch",
    "build": "echo \"Please run 'npm run build:production' instead\" && exit 1",
    "build:chrome": "node scripts/build.mjs --platform=chrome",
    "build:firefox": "node scripts/build.mjs --platform=firefox",
    "build:production": "npm-run-all --sequential build:chrome build:firefox",
    "typecheck": "tsrs -p . --noEmit",
    "typecheck:watch": "tsc --noEmit --pretty --watch",
    "test:unit": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:dapp": "node scripts/test-dapp-e2e.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "ui-lab": "vp dev --config src/ui-lab/vite.config.ts",
    "lint": "vp lint --fix",
    "lint:check": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "husky install",
    "changeset": "changeset",
    "version": "node scripts/release/version.mjs",
    "postversion": "node ./scripts/manifest-version.js",
    "release:tag": "node scripts/release/tag-version.mjs",
    "release:store-zips": "node scripts/release/store-zips.mjs",
    "release:publish-stores": "node scripts/release/publish-stores.mjs",
    "refresh-networks-fallback": "node scripts/refresh-networks-fallback.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "build:beta": "node scripts/build.mjs --brand=beta",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@download/blockies": "^1.0.3",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/hdnode": "^5.7.0",
    "@ethersproject/wallet": "^5.7.0",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ed25519": "^2.2.3",
    "@react-spring/web": "^9.7.3",
    "@solana/spl-token": "^0.4.13",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/web3.js": "^1.98.0",
    "@store-unit/react": "^1.0.4",
    "@tanstack/react-query": "^4.35.3",
    "@tanstack/react-virtual": "^3.2.0",
    "@walletconnect/jsonrpc-provider": "^1.0.13",
    "@walletconnect/jsonrpc-utils": "^1.0.8",
    "@zeriontech/components": "^1.1.0",
    "@zeriontech/hardware-wallet-connection": "^2.0.0",
    "@zeriontech/solana-wallet-standard": "^1.0.0-alpha.2",
    "bignumber.js": "^9.1.1",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.6.0",
    "capitalize-ts": "^1.0.0",
    "chart.js": "^4.4.8",
    "chartjs-plugin-zoom": "^2.2.0",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.9",
    "downshift": "^7.6.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.14.0",
    "events": "^3.3.0",
    "eventsource": "^4.0.0",
    "get-error": "^1.0.1",
    "immer": "^10.0.2",
    "is-truthy-ts": "^1.0.1",
    "ky": "^0.33.3",
    "lodash": "^4.17.21",
    "lottie-web": "^5.12.2",
    "memoize-one": "^6.0.0",
    "motion": "^12.38.0",
    "nanoevents": "^8.0.0",
    "nanoid": "^4.0.2",
    "normalize.css": "^8.0.1",
    "normalized-contains": "^1.0.0",
    "react": "^18.2.0",
    "react-area": "^0.1.1-alpha.6",
    "react-dom": "^18.2.0",
    "react-qrcode-logo": "^2.9.0",
    "react-router-dom": "^6.18.0",
    "rlp": "^3.0.0",
    "store-unit": "^1.0.3",
    "stream-browserify": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.0",
    "webextension-polyfill": "^0.10.0",
    "zksync-ethers": "^6.17.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.50.0",
    "@tanstack/eslint-plugin-query": "^4.39.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/chrome": "^0.0.270",
    "@types/dom-navigation": "^1.0.5",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.4.0",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@types/socket.io-client": "^1.4.36",
    "@types/uuid": "^9.0.2",
    "@types/w3c-web-usb": "^1.0.10",
    "@types/webextension-polyfill": "^0.10.1",
    "@vitejs/plugin-react": "6.1.2",
    "confusing-browser-globals": "^1.0.11",
    "dotenv": "^16.4.5",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "npm-run-all": "^4.1.5",
    "publish-browser-extension": "^6.2.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.8.2",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-svgr": "5.2.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "vp lint --fix",
    "*.{ts,tsx,css,md,json}": "vp fmt"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
