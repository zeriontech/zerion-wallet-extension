{
  "name": "zerion-wallet",
  "version": "1.45.2",
  "description": "A web3 wallet extension",
  "keywords": [
    "Browser",
    "Wallet",
    "Web3"
  ],
  "homepage": "https://github.com/zeriontech/zerion-wallet-extension#readme",
  "bugs": {
    "url": "https://github.com/zeriontech/zerion-wallet-extension/issues"
  },
  "license": "GPL-3.0-only",
  "author": "everdimension <everdimension@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zeriontech/zerion-wallet-extension.git"
  },
  "scripts": {
    "prestart": "node scripts/verifyDotEnv.cjs",
    "start": "npm-run-all --parallel start:chrome typecheck:watch",
    "start:chrome": "node scripts/build.mjs --platform=chrome --watch",
    "start:firefox": "node scripts/build.mjs --platform=firefox --watch",
    "build": "echo \"Please run 'npm run build:production' instead\" && exit 1",
    "build:chrome": "node scripts/build.mjs --platform=chrome",
    "build:firefox": "node scripts/build.mjs --platform=firefox",
    "build:production": "npm-run-all --sequential build:chrome build:firefox",
    "typecheck": "tsrs -p . --noEmit",
    "typecheck:watch": "tsc --noEmit --pretty --watch",
    "test:unit": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "ui-lab": "vp dev --config src/ui-lab/vite.config.ts",
    "lint": "vp lint --fix",
    "lint:check": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "husky install",
    "changeset": "changeset",
    "version": "node scripts/release/version.mjs",
    "postversion": "node ./scripts/manifest-version.js",
    "release:tag": "node scripts/release/tag-version.mjs",
    "release:store-zips": "node scripts/release/store-zips.mjs",
    "release:publish-stores": "node scripts/release/publish-stores.mjs",
    "refresh-networks-fallback": "node scripts/refresh-networks-fallback.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "build:beta": "node scripts/build.mjs --brand=beta",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.42",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.2.0",
    "@react-spring/web": "^10.0.4",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^3.0.1",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@walletconnect/jsonrpc-provider": "^1.0.14",
    "@walletconnect/jsonrpc-utils": "^1.0.8",
    "@zeriontech/components": "^2.0.1",
    "@zeriontech/hardware-wallet-connection": "^2.0.0",
    "@zeriontech/solana-wallet-standard": "^1.0.0-alpha.2",
    "bignumber.js": "^9.3.1",
    "bip39": "^3.1.2",
    "bs58": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "downshift": "^9.4.0",
    "ed25519-hd-key": "^2.0.0",
    "ethers": "^6.17.0",
    "events": "^3.3.0",
    "eventsource": "^5.1.3",
    "immer": "^11.1.21",
    "ky": "^2.1.0",
    "lodash": "^4.18.1",
    "lottie-web": "^5.13.0",
    "memoize-one": "^6.0.0",
    "motion": "^14.0.0",
    "nanoevents": "^10.0.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qrcode-logo": "^4.1.0",
    "react-router": "^7.18.4",
    "uuid": "^14.0.3",
    "webextension-polyfill": "^0.12.0",
    "zksync-ethers": "^6.21.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.3.4",
    "@types/dom-navigation": "^1.0.7",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.10.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/socket.io-client": "^1.4.36",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "^16.4.5",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "publish-browser-extension": "^6.2.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.9.3",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-svgr": "5.2.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "@zeriontech/solana-wallet-standard": {
      "@solana/web3.js": "$@solana/web3.js"
    },
    "base-x@^3.0.0": "3.0.11",
    "base-x@^5.0.0": "5.0.1",
    "bn.js@^4.0.0": "4.12.3",
    "bn.js@^5.0.0": "5.2.5",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "js-yaml": "4.3.2",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "uuid@^8.3.2": "11.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "ws@^7.0.0": "7.5.11",
    "ws@^8.0.0": "8.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "vp lint --fix",
    "*.{ts,tsx,css,md,json}": "vp fmt"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
