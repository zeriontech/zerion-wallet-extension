  ""0x1"": "returns {"_hex":"0x01","_isBigNumber":true}",
  ""0x2105"": "returns {"_hex":"0x2105","_isBigNumber":true}",
  ""0x89"": "returns {"_hex":"0x89","_isBigNumber":true}",
